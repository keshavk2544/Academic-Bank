
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // loginTransactions and erpSessions are for server-side processing only.
    match /loginTransactions/{transactionId} {
      allow read, write: if false;
    }
    
    match /erpSessions/{sessionId} {
      allow read, write: if false;
    }

    // Allow authenticated users to read their own profiles.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Resources are publicly readable but only creatable by anyone for MVP purposes
    match /resources/{resourceId} {
      allow read: if true;
      allow create: if true;
      allow delete: if true;
    }

    // Reactions are public for counts but writing is restricted for identity consistency
    match /reactions/{reactionId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
