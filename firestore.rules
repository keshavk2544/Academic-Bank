
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // loginTransactions and erpSessions are for server-side processing only.
    // We restrict all direct client-side access to protect sensitive session data.
    match /loginTransactions/{transactionId} {
      allow read, write: if false;
    }
    
    match /erpSessions/{sessionId} {
      allow read, write: if false;
    }

    // Allow authenticated users to read their own profiles.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
