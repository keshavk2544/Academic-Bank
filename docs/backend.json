
{
  "entities": {
    "LoginTransaction": {
      "title": "Login Transaction",
      "description": "Short-lived server-side storage for QUMS authentication sessions.",
      "type": "object",
      "properties": {
        "cookies": {
          "type": "string",
          "description": "Serialized QUMS cookie jar (ASP.NET_SessionId, CSRF cookies, etc.)"
        },
        "token": {
          "type": "string",
          "description": "QUMS __RequestVerificationToken extracted from the login page."
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time",
          "description": "Expiration timestamp (usually 10 minutes after creation)."
        }
      },
      "required": ["cookies", "token", "expiresAt"]
    },
    "ERPSession": {
      "title": "ERP Session",
      "description": "Server-side storage for authenticated student sessions.",
      "type": "object",
      "properties": {
        "qumsCookies": {
          "type": "string",
          "description": "Authenticated QUMS cookie jar."
        },
        "student": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "qid": { "type": "string" },
            "course": { "type": "string" },
            "section": { "type": "string" }
          },
          "required": ["name", "qid", "course", "section"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "expiresAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["qumsCookies", "student", "createdAt", "expiresAt"]
    },
    "Resource": {
      "title": "Academic Resource",
      "description": "An academic material stored in Firebase Storage with metadata in Firestore.",
      "type": "object",
      "properties": {
        "uploaderName": { "type": "string" },
        "qid": { "type": "string" },
        "fileName": { "type": "string" },
        "resourceType": { "type": "string", "enum": ["pyq", "notes", "imp", "mft"] },
        "examType": { "type": "string", "enum": ["MID SEM", "END SEM"], "description": "Specific for PYQ types" },
        "course": { "type": "string" },
        "subject": { "type": "string" },
        "year": { "type": "number" },
        "faculty": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["approved", "pending", "rejected"] },
        "size": { "type": "string", "description": "Formatted size string for UI" },
        "fileSize": { "type": "number", "description": "Raw file size in bytes" },
        "contentType": { "type": "string" },
        "storagePath": { "type": "string", "description": "Path to the file in Firebase Storage" }
      },
      "required": ["uploaderName", "qid", "fileName", "resourceType", "course", "subject", "createdAt", "status", "storagePath"]
    },
    "Reaction": {
      "title": "Document Reaction",
      "description": "A student reaction (Like/Dislike) to an academic resource.",
      "type": "object",
      "properties": {
        "documentId": { "type": "string" },
        "userId": { "type": "string" },
        "reactionType": { "type": "string", "enum": ["like", "dislike"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["documentId", "userId", "reactionType", "createdAt", "updatedAt"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/loginTransactions/{transactionId}": {
      "schema": { "$ref": "#/backend/entities/LoginTransaction" },
      "description": "Temporary store for pre-authenticated QUMS sessions."
    },
    "/erpSessions/{sessionId}": {
      "schema": { "$ref": "#/backend/entities/ERPSession" },
      "description": "Secure store for active student sessions mapping opaque IDs to university cookies and cached profiles."
    },
    "/resources/{resourceId}": {
      "schema": { "$ref": "#/backend/entities/Resource" },
      "description": "Collection of academic materials contributed by students."
    },
    "/reactions/{reactionId}": {
      "schema": { "$ref": "#/backend/entities/Reaction" },
      "description": "Collection of student reactions to academic resources."
    }
  }
}
